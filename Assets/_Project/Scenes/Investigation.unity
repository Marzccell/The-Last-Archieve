--- !u!114 &1521207705
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1521207703}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 439e80f030e471745af79d4ec367ac80, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HotspotController
  evidenceLocation: "STAFF OFFICE \u2014 MAINTENANCE TERMINAL"
  evidenceLocationIndonesian: "KANTOR STAFF \u2014 TERMINAL PEMELIHARAAN"
  document1:
    evidenceID: E03_WORK_ORDER_REVISION_HISTORY
    tabName: WORK ORDER HISTORY
    evidenceTitle: WORK ORDER & REVISION HISTORY
    evidenceType: MAINTENANCE WORK ORDER
    evidenceBody: "MAINTENANCE WORK ORDER MNT-204\r\n\r\nAREA: ROYAL SAPPHIRE DISPLAY\r\nSCHEDULED
      WINDOW: 20:02\u201320:18\r\n\r\nTECHNICIAN: LUCAS / MNT-04\r\nCURATOR SUPPORT:
      OLIVIA / CUR-02\r\nAPPROVER: GRACE / GRA-05\r\n\r\nAUTHORIZED TASKS:\r\n\u2022
      Outer case inspection\r\n\u2022 Alarm sensor calibration using CW-412\r\n\u2022
      Temporary sensor bypass during calibration\r\n\u2022 Camera diagnostic only
      if calibration fails\r\n\r\nPRE-MAINTENANCE AUTHORIZATION\r\n\r\n19:39\u201319:50
      CURATOR MOUNT VERIFICATION\r\nAUTHORIZED CREDENTIAL: CUR-02 ONLY\r\nPURPOSE:
      Replica fit and holder alignment check\r\nINNER HOLDER ACCESS: PERMITTED DURING
      THIS WINDOW\r\n\r\nREVISION HISTORY\r\n\r\n20:11:42 CALIBRATION ATTEMPT 1 \u2014
      FAILED\r\n\r\n20:13:47 BYPASS EXTENSION REQUESTED\r\n         REQUESTOR: MNT-04\r\n        
      REASON: CALIBRATION CONTINUATION\r\n\r\n20:14:02 WINDOW EXTENDED TO 20:28\r\n        
      APPROVED BY GRA-05\r\n         SECOND APPROVAL: MISSING\r\n\r\n20:14:09 SENSOR
      BYPASS EXTENDED TO 20:28\r\n\r\n20:18:40 CAMERA DIAGNOSTIC REQUEST OPENED\r\n\r\nPROCEDURE
      NOTE:\r\nAny extension affecting security systems requires a second museum
      approval."
    tabNameIndonesian: PERINTAH KERJA
    evidenceTitleIndonesian: PERINTAH KERJA & RIWAYAT REVISI
    evidenceTypeIndonesian: DOKUMEN PEMELIHARAAN
    evidenceBodyIndonesian: "PERINTAH KERJA PEMELIHARAAN MNT-204\r\nAREA: PAJANGAN
      ROYAL SAPPHIRE\r\nJADWAL PELAKSANAAN: 20:02\u201320:18\r\nTEKNISI: LUCAS /
      MNT-04\r\nDUKUNGAN KURATOR: OLIVIA / CUR-02\r\nPENYETUJU: GRACE / GRA-05\r\n\r\nTUGAS
      YANG DIIZINKAN:\r\n\u2022 Pemeriksaan bagian luar kotak pajangan\r\n\u2022
      Kalibrasi sensor alarm menggunakan CW-412\r\n\u2022 Bypass sensor sementara
      selama kalibrasi\r\n\u2022 Diagnostik kamera hanya jika kalibrasi gagal\r\n\r\nOTORISASI
      PRA-PEMELIHARAAN\r\n19:39\u201319:50 VERIFIKASI DUDUKAN OLEH KURATOR\r\nKREDENSIAL
      YANG DIIZINKAN: HANYA CUR-02\r\nTUJUAN: Pemeriksaan kecocokan replika dan posisi
      dudukan\r\nAKSES DUDUKAN DALAM: DIIZINKAN SELAMA PERIODE INI\r\n\r\nRIWAYAT
      REVISI\n\r\n20:11:42 PERCOBAAN KALIBRASI 1 \u2014 GAGAL\n\r\n20:13:47 PERMINTAAN
      PERPANJANGAN BYPASS\r\n       PEMOHON: MNT-04\r\n       ALASAN: MELANJUTKAN
      KALIBRASI\n\r\n20:14:02 PERIODE DIPERPANJANG HINGGA 20:28\r\n       DISETUJUI
      OLEH GRA-05\r\n       PERSETUJUAN KEDUA: TIDAK ADA\n\r\n20:14:09 BYPASS SENSOR
      DIPERPANJANG HINGGA 20:28\n\r\n20:18:40 PERMINTAAN DIAGNOSTIK KAMERA DIBUKA\r\n\r\nCATATAN
      PROSEDUR:\r\nSetiap perpanjangan yang memengaruhi sistem keamanan memerlukan
      persetujuan kedua dari pihak museum."
  document2:
    evidenceID: E04_CALIBRATION_TOOL_LEDGER
    tabName: TOOL LEDGER
    evidenceTitle: CALIBRATION & TOOL LEDGER
    evidenceType: MAINTENANCE LEDGER
    evidenceBody: "LUCAS CALIBRATION & TOOL LEDGER\r\n\r\nWORK ORDER: MNT-204\r\n\r\n19:55:10
      CW-412 CHECKED OUT\r\n         REGISTERED MASS: 412 g\r\n         USER: MNT-04\r\n\r\n20:02:30
      CALIBRATION STARTED\r\n\r\n20:11:42 ATTEMPT 1 FAILED \u2014 REFERENCE DRIFT\r\n\r\n20:14:15
      BYPASS EXTENSION CONFIRMED\r\n\r\n20:18:52 REMOTE DIAGNOSTIC STARTED \u2014
      SECURITY OFFICE\r\n\r\n20:27:06 CW-412 RETURN SCAN\r\n         DESTINATION:
      TOOL CASE M-04\r\n\r\n20:27:12 M-04 CASE WEIGHT: +412 g FROM 19:50 BASELINE\r\n\r\nOPEN
      ITEMS:\r\n\u2022 Technician report says reference tool was returned \u201Cbefore
      20:18.\u201D\r\n\u2022 Physical return scan occurred at 20:27.\r\n\r\nCHAIN-OF-CUSTODY
      STATUS: COMPLETE"
    tabNameIndonesian: LOG KALIBRASI
    evidenceTitleIndonesian: LOG KALIBRASI & PERALATAN LUCAS
    evidenceTypeIndonesian: CATATAN PERALATAN
    evidenceBodyIndonesian: "LOG KALIBRASI & PERALATAN LUCAS\r\nPERINTAH KERJA: MNT-204\r\n\r\n19:55:10
      CW-412 DIAMBIL\r\n       MASSA TERDAFTAR: 412 g\r\n       PENGGUNA: MNT-04\n\r\n20:02:30
      KALIBRASI DIMULAI\n\r\n20:11:42 PERCOBAAN 1 GAGAL \u2014 PERGESERAN REFERENSI\n\r\n20:14:15
      PERPANJANGAN BYPASS DIKONFIRMASI\n\r\n20:18:52 DIAGNOSTIK JARAK JAUH DIMULAI
      \u2014 KANTOR KEAMANAN\n\r\n20:27:06 PEMINDAIAN PENGEMBALIAN CW-412\r\n      
      TUJUAN: KOTAK PERALATAN M-04\n\r\n20:27:12 BERAT KOTAK M-04: +412 g DARI BASELINE
      19:50\r\n\r\nMASALAH YANG BELUM SELESAI:\r\n\u2022 Laporan teknisi menyatakan
      alat referensi dikembalikan \u201Csebelum 20:18.\u201D\r\n\u2022 Pemindaian
      pengembalian fisik terjadi pada pukul 20:27.\r\n\r\nSTATUS RANTAI PENYIMPANAN:
      LENGKAP"
  hotspotName: MAINTENANCE DOCUMENT
  hotspotContentSummary: 2 DOCUMENTS
  hotspotNameIndonesian: DOKUMEN  PEMELIHARAAN
  hotspotContentSummaryIndonesian: 2 DOKUMEN
  hotspotNameText: {fileID: 49906754}
  hotspotCountText: {fileID: 578318426}
  presentationStyle: 4
  popupController: {fileID: 869402488}
