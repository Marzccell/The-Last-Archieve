MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1963662676}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 439e80f030e471745af79d4ec367ac80, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HotspotController
  evidenceLocation: "SECURITY OFFICE \u2014 CCTV COMPUTER"
  evidenceLocationIndonesian: "KANTOR KEAMANAN \u2014 KOMPUTER CCTV "
  document1:
    evidenceID: E05_CCTV_MOVEMENT_TIMELINE
    tabName: CCTV TIMELINE
    evidenceTitle: CCTV MOVEMENT TIMELINE
    evidenceType: CCTV RECORD
    evidenceBody: "MUSEUM CCTV MOVEMENT TIMELINE\r\n\r\nDATE: 14 AUGUST\r\n\r\n19:32
      GRACE \u2014 STAFF RECORDS BAY ENTRY\r\n\r\n19:36 \u2014 UNIDENTIFIED CURATORIAL
      STAFF \u2014 REPLICA STORAGE CORRIDOR; carrying standard collection case\r\n\r\n19:40
      \u2014 SAME INDIVIDUAL \u2014 MAIN EXHIBITION HALL ENTRY\r\n\r\n19:41 DANIEL
      \u2014 MUSEUM ENTRANCE CHECKPOINT\r\n\r\n19:41\u201319:44 GRACE \u2014 RECORDS
      BAY DESK CAMERA; continuous presence\r\n\r\n19:44 DANIEL \u2014 MUSEUM ENTRANCE
      EXIT CHECKPOINT\r\n\r\n19:45 OLIVIA \u2014 STAFF OFFICE / DISPATCH CORRIDOR\r\n\r\n19:49
      DANIEL \u2014 EAST SERVICE PASSAGE; emergency equipment cart visible\r\n\r\n19:55
      LUCAS \u2014 MAINTENANCE ROOM EXIT; tool case visible\r\n\r\n20:02 OLIVIA +
      LUCAS \u2014 MAIN EXHIBITION HALL\r\n\r\n20:04 OLIVIA \u2014 HALL EXIT TOWARD
      STAFF RECORDS BAY\r\n\r\n20:05 OLIVIA \u2014 STAFF RECORDS BAY ENTRY / CUR-02\r\n\r\n20:12
      OLIVIA \u2014 RECORDS BAY DESK CAMERA\r\n\r\n20:18 LUCAS \u2014 SECURITY OFFICE
      CAMERA CONSOLE\r\n\r\n20:18 ETHAN \u2014 ARCHIVE ROOM CORRIDOR\r\n\r\n20:19\u201320:24
      CAMERA C-04 \u2014 NO VIDEO\r\n\r\n20:21 OLIVIA \u2014 RECORDS BAY DOCUMENT
      SCANNER / CUR-02\r\n\r\n20:24 ETHAN \u2014 STAFF OFFICE RETURN CORRIDOR\r\n\r\n20:24
      LUCAS \u2014 SECURITY OFFICE\r\n\r\n20:29 OLIVIA \u2014 STAFF RECORDS BAY EXIT
      / CUR-02\r\n\r\nCAMERA NOTE:\r\n\r\nC-04 covers East Service Passage and the
      rear Hall approach.\r\n\r\nStaff Records Bay has one controlled entrance. No
      unlogged exit is available."
    tabNameIndonesian: TIMELINE CCTV
    evidenceTitleIndonesian: TIMELINE PERGERAKAN CCTV MUSEUM
    evidenceTypeIndonesian: CATATAN CCTV
    evidenceBodyIndonesian: "TIMELINE PERGERAKAN CCTV MUSEUM\r\nTANGGAL: 14 AGUSTUS\r\n\r\n19:32
      GRACE \u2014 MEMASUKI RUANG ARSIP STAF\n\r\n19:36 OLIVIA \u2014 KORIDOR PENYIMPANAN
      REPLIKA; membawa kotak koleksi standar\n\r\n19:40 OLIVIA \u2014 MEMASUKI AULA
      PAMERAN UTAMA\n\r\n19:41 DANIEL \u2014 CHECKPOINT PINTU MASUK MUSEUM\n\r\n19:41\u201319:44
      GRACE \u2014 KAMERA MEJA RUANG ARSIP; keberadaan terus-menerus\n\r\n19:44 DANIEL
      \u2014 CHECKPOINT KELUAR PINTU MASUK MUSEUM\n\r\n19:45 OLIVIA \u2014 KANTOR
      STAF / KORIDOR PENGIRIMAN\n\r\n19:49 DANIEL \u2014 LORONG SERVIS TIMUR; troli
      peralatan darurat terlihat\n\r\n19:55 LUCAS \u2014 KELUAR DARI RUANG PEMELIHARAAN;
      kotak peralatan terlihat\n\r\n20:02 OLIVIA + LUCAS \u2014 AULA PAMERAN UTAMA\n\r\n20:04
      OLIVIA \u2014 KELUAR DARI AULA MENUJU RUANG ARSIP STAF\n\r\n20:05 OLIVIA \u2014
      MEMASUKI RUANG ARSIP STAF / CUR-02\n\r\n20:12 OLIVIA \u2014 KAMERA MEJA RUANG
      ARSIP\n\r\n20:21 OLIVIA \u2014 PEMINDAI DOKUMEN RUANG ARSIP / CUR-02\n\r\n20:18
      LUCAS \u2014 KONSOL KAMERA KANTOR KEAMANAN\n\r\n20:18 ETHAN \u2014 KORIDOR
      RUANG ARSIP\n\r\n20:19\u201320:24 KAMERA C-04 \u2014 TIDAK ADA VIDEO\n\r\n20:24
      ETHAN \u2014 KORIDOR KEMBALI KE KANTOR STAF\n\r\n20:24 LUCAS \u2014 KANTOR
      KEAMANAN\n\r\n20:29 OLIVIA \u2014 KELUAR DARI RUANG ARSIP STAF / CUR-02\r\n\r\nCATATAN
      KAMERA:\n\r\nC-04 mencakup Lorong Servis Timur dan jalur belakang menuju Aula.\n\r\nRuang
      Arsip Staf memiliki satu pintu masuk yang dikontrol. Tidak tersedia pintu keluar
      tanpa pencatatan."
  document2:
    evidenceID: E06_CAMERA_HEALTH_REBOOT_LOG
    tabName: CAMERA REBOOT LOG
    evidenceTitle: CAMERA HEALTH & REBOOT LOG
    evidenceType: SYSTEM LOG
    evidenceBody: "CAMERA HEALTH & REBOOT LOG\r\n\r\nCAMERA: C-04 / EAST SERVICE
      PASSAGE\r\n\r\n20:11:49 CALIBRATION ERROR SIGNAL RECEIVED\r\n\r\n20:18:40 DIAGNOSTIC
      REQUEST OPENED \u2014 MNT-04\r\n\r\n20:19:02 MANUAL REBOOT INITIATED\r\n\r\nTERMINAL:
      SECURITY-CONSOLE-02\r\n\r\nCREDENTIAL: MNT-04\r\n\r\n20:19:08 VIDEO STREAM
      OFFLINE\r\n\r\n20:23:44 VIDEO STREAM RESTORING\r\n\r\n20:24:03 C-04 ONLINE\r\n\r\nREBOOT
      TYPE: MANUAL\r\n\r\nAUTOMATIC RESTART TRIGGER: NONE\r\n\r\nPOLICY NOTE:\r\n\r\nManual
      camera reboot during open maintenance requires technician report and supervisor
      co-sign."
    tabNameIndonesian: LOG REBOOT KAMERA
    evidenceTitleIndonesian: LOG KONDISI & REBOOT KAMERA
    evidenceTypeIndonesian: LOG SISTEM CCTV
    evidenceBodyIndonesian: "LOG KONDISI & REBOOT KAMERA\r\n\r\nKAMERA: C-04 / LORONG
      SERVIS TIMUR\r\n\r\n\r\n20:11:49 SINYAL KESALAHAN KALIBRASI DITERIMA\r\n\r\n20:18:40
      PERMINTAAN DIAGNOSTIK DIBUKA \u2014 MNT-04\r\n\r\n20:19:02 REBOOT MANUAL DIMULAI\r\n\r\nTERMINAL:
      SECURITY-CONSOLE-02\r\n\r\nKREDENSIAL: MNT-04\r\n\r\n20:19:08 ALIRAN VIDEO
      OFFLINE\r\n\r\n20:23:44 ALIRAN VIDEO SEDANG DIPULIHKAN\r\n\r\n20:24:03 C-04
      ONLINE\r\n\r\n\r\nJENIS REBOOT: MANUAL\r\n\r\nPEMICU RESTART OTOMATIS: TIDAK
      ADA\r\n\r\n\r\nCATATAN KEBIJAKAN:\r\n\r\nReboot kamera secara manual saat pemeliharaan
      berlangsung memerlukan laporan teknisi dan persetujuan supervisor."
  hotspotName: CCTV COMPUTER
  hotspotContentSummary: 2 DOCUMENTS
  hotspotNameIndonesian: KOMPUTER CCTV
  hotspotContentSummaryIndonesian: 2 DOKUMEN
  hotspotNameText: {fileID: 1470894375}
  hotspotCountText: {fileID: 888166045}
  presentationStyle: 2
  popupController: {fileID: 869402488}
