  m_Script: {fileID: 11500000, guid: 439e80f030e471745af79d4ec367ac80, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HotspotController
  evidenceLocation: "STAFF OFFICE \u2014 ETHAN'S WORKSTATION"
  evidenceLocationIndonesian: "KANTOR STAF \u2014 WORKSTATION ETHAN"
  document1:
    evidenceID: E09_WORKSTATION_ACTIVITY_LOG
    tabName: ACTIVITY LOG
    evidenceTitle: ETHAN WORKSTATION ACTIVITY LOG
    evidenceType: COMPUTER ACTIVITY LOG
    evidenceBody: 'ETHAN WORKSTATION ACTIVITY LOG

      WORKSTATION: ADMIN-DESK-03

      REGISTERED
      USER: ETHAN / ADM-03



      19:58 USER SESSION UNLOCKED

      20:07 MONTHLY
      VISITOR REPORT OPENED

      20:12 AUTOREPORTTASK LAUNCHED

      20:13 REPORT
      SECTION 4 UPDATED

      20:16 DATA TABLE REFRESHED

      20:20 KEYBOARD ACTIVITY
      EVENT

      20:22 DOCUMENT AUTOSAVED

      20:25 ARCHIVE INDEX UPDATED

      20:28
      FINAL SAVE COMPLETED

      20:30 USER SESSION LOCKED



      SYSTEM NOTE:

      This
      log records workstation events. It does not classify whether an event was produced
      by physical input, a macro, or a scheduled task.'
    tabNameIndonesian: LOG AKTIVITAS
    evidenceTitleIndonesian: LOG AKTIVITAS WORKSTATION ETHAN
    evidenceTypeIndonesian: LOG KOMPUTER
    evidenceBodyIndonesian: 'LOG AKTIVITAS WORKSTATION ETHAN



      WORKSTATION:
      ADMIN-DESK-03



      PENGGUNA TERDAFTAR: ETHAN / ADM-03





      19:58
      SESI PENGGUNA DIBUKA



      20:07 LAPORAN PENGUNJUNG BULANAN DIBUKA



      20:12
      AUTOREPORTTASK DIJALANKAN



      20:13 BAGIAN 4 LAPORAN DIPERBARUI



      20:16
      TABEL DATA DIPERBARUI



      20:20 AKTIVITAS KEYBOARD TERDETEKSI



      20:22
      DOKUMEN DISIMPAN OTOMATIS



      20:25 INDEKS ARSIP DIPERBARUI



      20:28
      PENYIMPANAN AKHIR SELESAI



      20:30 SESI PENGGUNA DIKUNCI





      CATATAN
      SISTEM:



      Log ini mencatat aktivitas workstation.



      Log ini tidak
      menentukan apakah suatu aktivitas dihasilkan oleh input fisik, macro, atau
      tugas terjadwal.'
  document2:
    evidenceID: E10_AUTOMATIC_TASK_HISTORY
    tabName: AUTOMATIC TASK HISTORY
    evidenceTitle: AUTOMATIC TASK EXECUTION HISTORY
    evidenceType: SYSTEM TASK LOG
    evidenceBody: "AUTOMATIC TASK EXECUTION HISTORY\r\nTASK: AUTOREPORTTASK\r\nOWNER:
      ADM-03\r\nCREATED: 14 AUGUST, 19:12\r\n\r\nCONFIGURATION\r\n20:12 START TASK\r\n20:13
      INSERT SECTION 4 TEMPLATE\r\n20:16 REFRESH VISITOR DATA TABLE\r\n20:20 SEND
      KEEP-AWAKE KEY EVENT\r\n20:22 SAVE ACTIVE DOCUMENT\r\n20:25 REBUILD ARCHIVE
      INDEX\r\n20:28 FINAL SAVE AND CLOSE\r\n\r\nEXECUTION RESULT: COMPLETED WITHOUT
      USER INTERRUPTION\r\nPHYSICAL KEYBOARD INPUT DETECTED 20:12\u201320:28: NONE\r\n\r\nRECENT
      SEARCHES BY ADM-03\r\n18:54 \u201CTR-17 training replica location\u201D\r\n18:57
      \u201CA-17 shelf access\u201D\r\n19:03 \u201Cdisplay maintenance tolerance\u201D"
    tabNameIndonesian: TUGAS OTOMATIS
    evidenceTitleIndonesian: RIWAYAT EKSEKUSI TUGAS OTOMATIS
    evidenceTypeIndonesian: RIWAYAT SISTEM
    evidenceBodyIndonesian: "RIWAYAT EKSEKUSI TUGAS OTOMATIS\r\n\r\nTUGAS: AUTOREPORTTASK\r\n\r\nPEMILIK:
      ADM-03\r\n\r\nDIBUAT: 14 AGUSTUS, 19:12\r\n\r\n\r\nKONFIGURASI\r\n\r\n20:12
      MULAI TUGAS\r\n\r\n20:13 MASUKKAN TEMPLATE BAGIAN 4\r\n\r\n20:16 PERBARUI TABEL
      DATA PENGUNJUNG\r\n\r\n20:20 KIRIM AKTIVITAS TOMBOL AGAR SISTEM TETAP AKTIF\r\n\r\n20:22
      SIMPAN DOKUMEN AKTIF\r\n\r\n20:25 BANGUN ULANG INDEKS ARSIP\r\n\r\n20:28 SIMPAN
      DAN TUTUP\r\n\r\n\r\nHASIL EKSEKUSI: SELESAI TANPA GANGGUAN PENGGUNA\r\n\r\nINPUT
      KEYBOARD FISIK TERDETEKSI PUKUL 20:12\u201320:28: TIDAK ADA\r\n\r\n\r\nPENCARIAN
      TERBARU OLEH ADM-03\r\n\r\n18:54 \u201Clokasi replika latihan TR-17\u201D\r\n\r\n18:57
      \u201Cakses rak A-17\u201D\r\n\r\n19:03 \u201Cbatas toleransi pemeliharaan
      pajangan\u201D"
  hotspotName: ETHAN'S WORKSTATION
  hotspotContentSummary: 2 DOCUMENTS
  hotspotNameIndonesian: WORKSTATION ETHAN
  hotspotContentSummaryIndonesian: 2 DOKUMEN
  hotspotNameText: {fileID: 1734650815}
  hotspotCountText: {fileID: 1887051528}
