--- !u!114 &457077355
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 457077353}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 439e80f030e471745af79d4ec367ac80, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HotspotController
  evidenceLocation: "STAFF OFFICE \u2014 C-07 DISPATCH AREA"
  evidenceLocationIndonesian: "KANTOR STAF \u2014 AREA PENGIRIMAN C-07"
  document1:
    evidenceID: E13_C07_CRATE_WEIGHT_AUDIT
    tabName: CRATE WEIGHT AUDIT
    evidenceTitle: C-07 CRATE WEIGHT AUDIT
    evidenceType: DISPATCH WEIGHT RECORD
    evidenceBody: "OUTGOING RESTORATION CRATE \u2014 WEIGHT AUDIT\r\nCRATE ID: C-07\r\nSTATUS:
      PACKING IN PROGRESS\r\n\r\n19:20 PACKED CRATE BASELINE: 8,240 g\r\n      (crate
      and all registered contents included)\r\n\r\n19:34 DOCUMENT PACKET ADDED\r\n     
      (excluded from scale)\r\n\r\n19:46 PRE-SEAL WEIGHT RECORDED: 8,652 g\r\n\r\nSYSTEM
      FLAG:\r\nAn unregistered weight change occurred between\r\nthe baseline measurement
      and the pre-seal measurement.\r\nExact event timestamp unavailable.\r\n\r\n20:10
      PACKING SEAL APPLIED\r\n\r\n08:05 LOCKDOWN HOLD \u2014 CRATE REMAINS IN DISPATCH
      AREA\r\n\r\nEXPECTED MANIFEST WEIGHT: 8,240 g\r\nWEIGHT RECONCILIATION: PENDING\r\n\r\nSYSTEM
      NOTE:\r\nThe early-dispatch override moved full weight reconciliation\r\nto
      the destination lab.\r\nThe museum performs a seal check only before pickup."
    tabNameIndonesian: AUDIT BERAT
    evidenceTitleIndonesian: AUDIT BERAT PETI RESTORASI
    evidenceTypeIndonesian: CATATAN TIMBANGAN
    evidenceBodyIndonesian: "PETI RESTORASI KELUAR \u2014 AUDIT BERAT\r\n\r\nID PETI:
      C-07\r\n\r\nSTATUS: PROSES PENGEMASAN\r\n\r\n\r\n19:20 BASELINE PETI YANG TELAH
      DIKEMAS: 8.240 g\r\n      (peti dan seluruh isi yang terdaftar telah disertakan)\r\n\r\n19:34
      PAKET DOKUMEN DITAMBAHKAN\r\n      (tidak dihitung oleh timbangan)\r\n\r\n19:46
      BERAT PRA-SEGEL TERCATAT: 8.652 g\r\n\r\n\r\nPERINGATAN SISTEM:\r\nTerjadi
      perubahan berat yang tidak terdaftar antara pengukuran baseline dan pengukuran
      pra-segel.\r\nWaktu pasti terjadinya perubahan tidak tersedia.\r\n\r\n\r\n20:10
      SEGEL PENGEMASAN DIPASANG\r\n\r\n08:05 PENAHANAN LOCKDOWN \u2014 PETI TETAP
      BERADA DI AREA PENGIRIMAN\r\n\r\n\r\nBERAT MANIFEST YANG SEHARUSNYA: 8.240
      g\r\n\r\nREKONSILIASI BERAT: TERTUNDA\r\n\r\n\r\nCATATAN SISTEM:\r\n\r\nOverride
      pengiriman lebih awal memindahkan rekonsiliasi berat lengkap ke laboratorium
      tujuan.\r\nMuseum hanya melakukan pemeriksaan segel sebelum peti diambil."
  document2:
    evidenceID: E14_DISPATCH_MANIFEST_SCHEDULE
    tabName: MANIFEST & SCHEDULE
    evidenceTitle: DISPATCH MANIFEST & SCHEDULE HISTORY
    evidenceType: DISPATCH RECORD
    evidenceBody: "DISPATCH MANIFEST & SCHEDULE HISTORY\r\nCRATE: C-07\r\nDESTINATION:
      NATIONAL RESTORATION LAB\r\n\r\nORIGINAL DEPARTURE: 09:30 / 15 AUGUST\r\n\r\n19:31
      VENDOR REQUEST RECEIVED:\r\n      EARLIER COLLECTION\r\n\r\n19:33 DEPARTURE
      CHANGED: 09:30 \u2192 08:30\r\n      USER: GRA-05\r\n      SECOND APPROVAL:
      MISSING\r\n\r\n19:34 EARLY-DISPATCH OVERRIDE APPLIED\r\n      MUSEUM CHECK:
      SEAL ONLY\r\n      FULL WEIGHT CHECK: DESTINATION LAB\r\n\r\n19:34 PACKING
      OWNER ASSIGNED:\r\n      CUR-02\r\n\r\n20:10 PACKING SEAL APPLIED\r\n\r\n08:05
      LOCKDOWN HOLD APPLIED\r\n\r\n08:30 DISPATCH STATUS:\r\n      CANCELLED BY LOCKDOWN\r\n\r\nMANIFESTED
      CONTENTS:\r\n\u2022 Two bronze restoration mounts\r\n\u2022 Conservation foam
      set\r\n\u2022 Humidity monitor\r\n\u2022 Documentation packet\r\n\r\nNO 412
      g GEMSTONE OR REPLICA IS LISTED."
    tabNameIndonesian: MANIFEST PENGIRIMAN
    evidenceTitleIndonesian: MANIFEST PENGIRIMAN & RIWAYAT JADWAL
    evidenceTypeIndonesian: CATATAN PENGIRIMAN
    evidenceBodyIndonesian: "MANIFEST PENGIRIMAN & RIWAYAT JADWAL\r\n\r\nPETI: C-07\r\n\r\nTUJUAN:
      LABORATORIUM RESTORASI NASIONAL\r\n\r\n\r\nJADWAL KEBERANGKATAN AWAL: 09:30
      / 15 AGUSTUS\r\n\r\n19:31 PERMINTAAN VENDOR DITERIMA: PENGAMBILAN LEBIH AWAL\r\n\r\n19:33
      JADWAL KEBERANGKATAN DIUBAH: 09:30 \u2192 08:30\r\n        PENGGUNA: GRA-05\r\n       
      PERSETUJUAN KEDUA: TIDAK ADA\r\n\r\n19:34 OVERRIDE PENGIRIMAN LEBIH AWAL DITERAPKAN\r\n       
      PEMERIKSAAN MUSEUM: HANYA SEGEL\r\n        PEMERIKSAAN BERAT LENGKAP: LABORATORIUM
      TUJUAN\r\n\r\n19:34 PENANGGUNG JAWAB PENGEMASAN:  CUR-02\r\n\r\n20:10 SEGEL
      PENGEMASAN DIPASANG\r\n\r\n08:05 PENAHANAN LOCKDOWN DITERAPKAN\r\n\r\n08:30
      STATUS PENGIRIMAN \u2014 DIBATALKAN KARENA LOCKDOWN\r\n\r\n\r\nISI YANG TERCANTUM
      DALAM MANIFEST:\r\n\r\n\u2022 Dua dudukan restorasi perunggu\r\n\r\n\u2022
      Satu set busa konservasi\r\n\r\n\u2022 Monitor kelembapan\r\n\r\n\u2022 Paket
      dokumen\r\n\r\n\r\nTIDAK ADA BATU PERMATA ATAU REPLIKA SEBERAT 412 g YANG TERCANTUM."
  hotspotName: C-07 DISPATCH AREA
  hotspotContentSummary: 2 DOCUMENTS
  hotspotNameIndonesian: PETI PENGIRIMAN C-07
  hotspotContentSummaryIndonesian: 2 DOKUMEN
  hotspotNameText: {fileID: 1638809767}
  hotspotCountText: {fileID: 640281124}
  presentationStyle: 4
  popupController: {fileID: 869402488}
