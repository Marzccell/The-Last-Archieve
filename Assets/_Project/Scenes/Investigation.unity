  m_Script: {fileID: 11500000, guid: 439e80f030e471745af79d4ec367ac80, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HotspotController
  evidenceLocation: "MAIN EXHIBITION HALL \u2014 DISPLAY SYSTEM PANEL"
  evidenceLocationIndonesian: 'AULA PAMERAN UTAMA - PANEL SISTEM PAJANGAN '
  document1:
    evidenceID: E01_DISPLAY_ACCESS_WEIGHT_LOG
    tabName: ACCESS & WEIGHT LOG
    evidenceTitle: ROYAL SAPPHIRE DISPLAY ACCESS & WEIGHT LOG
    evidenceType: DISPLAY SYSTEM LOG
    evidenceBody: "DATE: 14 AUGUST\r\nDISPLAY: MAIN EXHIBITION HALL / INNER HOLDER
      RS-MOUNT-01\r\n\r\n19:39:52 PRE-MAINTENANCE VERIFICATION MODE \u2014 ACTIVE\r\n\r\n19:42:08
      INNER HOLDER OPENED\r\n         SESSION: CUR-02\r\n\r\n19:42:16 OBJECT REMOVED
      \u2014 412 g\r\n         FIT PROFILE: F-71\r\n\r\n19:42:23 OBJECT PLACED \u2014
      412 g\r\n         FIT PROFILE: F-44\r\n\r\n19:42:31 INNER HOLDER CLOSED\r\n        
      NET WEIGHT CHANGE: 0 g\r\n\r\n20:02:04 WORK ORDER MNT-204 \u2014 ACTIVE\r\n\r\n20:04:37
      CURATOR SESSION CUR-02 \u2014 STILL ACTIVE\r\n\r\n20:14:09 SENSOR BYPASS EXTENDED
      TO 20:28\r\n\r\n20:20:11 INNER HOLDER OPENED\r\n         SESSION: CUR-02\r\n\r\n20:20:18
      OBJECT REMOVED \u2014 412 g\r\n         FIT PROFILE: F-44\r\n\r\n20:20:25 OBJECT
      PLACED \u2014 409 g\r\n         FIT PROFILE: F-09\r\n\r\n20:20:32 INNER HOLDER
      CLOSED\r\n\r\n20:28:05 MAINTENANCE BASELINE ACCEPTED \u2014 409 g\r\n\r\nSYSTEM
      NOTE:\r\nThe holder records session credentials, weight, and an anonymous Fit
      Profile.\r\nFit Profile codes do not contain object names. Compare them with
      the Collection Registry."
    tabNameIndonesian: LOG AKSES & BERAT
    evidenceTitleIndonesian: LOG AKSES & BERAT PAJANGAN ROYAL SAPPHIRE
    evidenceTypeIndonesian: LOG SISTEM
    evidenceBodyIndonesian: "LOG AKSES & BERAT PAJANGAN ROYAL SAPPHIRE\r\nTANGGAL:
      14 AGUSTUS\r\nPAJANGAN: AULA PAMERAN UTAMA / DUDUKAN DALAM RS-MOUNT-01\r\n\r\n19:39:52
      MODE VERIFIKASI PRA-PEMELIHARAAN \u2014 AKTIF\n\r\n19:42:08 DUDUKAN DALAM DIBUKA\r\n      
      SESI: CUR-02\n\r\n19:42:16 OBJEK DIANGKAT \u2014 412 g\r\n       PROFIL KECOCOKAN:
      F-71\n\r\n19:42:23 OBJEK DILETAKKAN \u2014 412 g\r\n       PROFIL KECOCOKAN:
      F-44\n\r\n19:42:31 DUDUKAN DALAM DITUTUP\r\n       PERUBAHAN BERAT BERSIH:
      0 g\r\n\r\n20:02:04 PERINTAH KERJA MNT-204 \u2014 AKTIF\n\r\n20:04:37 SESI
      KURATOR CUR-02 \u2014 MASIH AKTIF\n\r\n20:14:09 BYPASS SENSOR DIPERPANJANG
      HINGGA 20:28\n\r\n20:20:11 DUDUKAN DALAM DIBUKA\r\n       SESI: CUR-02\n\r\n20:20:18
      OBJEK DIANGKAT \u2014 412 g\r\n       PROFIL KECOCOKAN: F-44\n\r\n20:20:25
      OBJEK DILETAKKAN \u2014 409 g\r\n       PROFIL KECOCOKAN: F-09\n\r\n20:20:32
      DUDUKAN DALAM DITUTUP\n\r\n20:28:05 BASELINE PEMELIHARAAN DITERIMA \u2014 409
      g\r\n\r\nCATATAN SISTEM:\r\nDudukan mencatat kredensial sesi, berat, dan Profil
      Kecocokan anonim.\r\nKode Profil Kecocokan tidak memuat nama objek. Bandingkan
      kode tersebut dengan Registri Koleksi."
  document2:
    evidenceID: E02_MORNING_AUTHENTICITY_REPORT
    tabName: AUTHENTICITY REPORT
    evidenceTitle: POST-INCIDENT AUTHENTICITY REPORT
    evidenceType: AUTHENTICITY SCAN
    evidenceBody: "DATE: 15 AUGUST\r\nSCAN TIME: 08:00\r\n\r\nEXPECTED OBJECT:\r\nRS-01
      \u2014 ROYAL SAPPHIRE ORIGINAL\r\n\r\nDETECTED OBJECT:\r\nTR-17 \u2014 TRAINING
      REPLICA\r\n\r\nDETECTED WEIGHT:\r\n409 g\r\n\r\nIDENTIFICATION MARKERS:\r\n\u2022
      Training micro-engraving confirmed beneath lower mount.\r\n\u2022 Internal
      light-refraction pattern does not match RS-01.\r\n\u2022 Object condition matches
      Registry entry TR-17.\r\n\r\nRESULT:\r\nAUTHENTICITY FAILURE\r\n\r\n08:05 MUSEUM
      LOCKDOWN INITIATED\r\n\r\nNOTE:\r\nThe authenticity scanner runs once per day
      at 08:00.\r\nIt does not identify object changes in real time."
    tabNameIndonesian: LAPORAN KEASLIAN
    evidenceTitleIndonesian: LAPORAN KEASLIAN PASCA-INSIDEN
    evidenceTypeIndonesian: LAPORAN PEMINDAIAN
    evidenceBodyIndonesian: "LAPORAN KEASLIAN PASCA-INSIDEN\r\nTANGGAL: 15 AGUSTUS\r\nWAKTU
      PEMINDAIAN: 08:00\r\n\r\nOBJEK YANG SEHARUSNYA: RS-01 \u2014 ROYAL SAPPHIRE
      ASLI\r\nOBJEK YANG TERDETEKSI: TR-17 \u2014 REPLIKA LATIHAN\r\nBERAT TERDETEKSI:
      409 g\r\n\r\nPENANDA IDENTIFIKASI:\r\n\u2022 Ukiran mikro latihan terkonfirmasi
      di bawah dudukan bagian bawah.\r\n\u2022 Pola pembiasan cahaya internal tidak
      cocok dengan RS-01.\r\n\u2022 Kondisi objek cocok dengan entri Registri TR-17.\r\n\r\nHASIL:
      GAGAL VERIFIKASI KEASLIAN\r\n08:05 LOCKDOWN MUSEUM DIMULAI\r\n\r\nCATATAN:\r\nPemindai
      keaslian dijalankan sekali sehari pada pukul 08:00.\r\nSistem ini tidak mengidentifikasi
      pergantian objek secara langsung."
  hotspotName: DISPLAY SYSTEM PANEL
  hotspotContentSummary: 2 DOCUMENTS
  hotspotNameIndonesian: PANEL SISTEM PAJANGAN
  hotspotContentSummaryIndonesian: 2 DOKUMEN
  hotspotNameText: {fileID: 1120475919}
  hotspotCountText: {fileID: 34800889}
  presentationStyle: 1
  popupController: {fileID: 869402488}
