--- !u!114 &1606939672
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1606939670}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 439e80f030e471745af79d4ec367ac80, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HotspotController
  evidenceLocation: "STAFF OFFICE \u2014 COLLECTION DATABASE"
  evidenceLocationIndonesian: "KANTOR STAF \u2014 DATABASE KOLEKSI"
  document1:
    evidenceID: E11_REPLICA_CALIBRATION_REGISTRY
    tabName: OBJECT REGISTRY
    evidenceTitle: REPLICA & CALIBRATION REGISTRY
    evidenceType: COLLECTION REGISTRY
    evidenceBody: "COLLECTION & CALIBRATION REGISTRY\r\n\r\nRS-01 \u2014 ROYAL SAPPHIRE
      ORIGINAL\r\nRegistered Weight: 412 g\r\nFit Profile: F-71\r\nNormal Location:
      Main Exhibition Hall Display\r\n\r\nER-12 \u2014 EXHIBITION REPLICA\r\nRegistered
      Weight: 412 g\r\nFit Profile: F-44\r\nNormal Location: Replica Cabinet C-02\r\nPurpose:
      Display simulation and mount testing\r\n\r\nTR-17 \u2014 TRAINING REPLICA\r\nRegistered
      Weight: 409 g\r\nFit Profile: F-09\r\nNormal Location: Archive Shelf A-17\r\nPurpose:
      Staff handling practice\r\n\r\nCW-412 \u2014 CALIBRATION WEIGHT\r\nRegistered
      Weight: 412 g\r\nFit Profile: NOT REGISTERED \u2014 calibration tool only\r\nNormal
      Location: Maintenance Calibration Rack\r\nPurpose: Sensor calibration\r\n\r\nREGISTRY
      WARNING:\r\nWeight alone must not be used to confirm object identity.\r\nFit
      Profile must be matched with a display event before identifying a swapped object."
    tabNameIndonesian: REGISTRI KOLEKSI
    evidenceTitleIndonesian: REGISTRI KOLEKSI & KALIBRASI
    evidenceTypeIndonesian: DATABASE KOLEKSI
    evidenceBodyIndonesian: "REGISTRI KOLEKSI & KALIBRASI\r\n\r\n\r\nRS-01 \u2014
      ROYAL SAPPHIRE ASLI\r\n\r\nBerat Terdaftar: 412 g\r\n\r\nProfil Kecocokan:
      F-71\r\n\r\nLokasi Normal: Pajangan Aula Pameran Utama\r\n\r\n\r\nER-12 \u2014
      REPLIKA PAMERAN\r\n\r\nBerat Terdaftar: 412 g\r\n\r\nProfil Kecocokan: F-44\r\n\r\nLokasi
      Normal: Lemari Replika C-02\r\n\r\nTujuan: Simulasi pajangan dan pengujian
      dudukan\r\n\r\n\r\nTR-17 \u2014 REPLIKA LATIHAN\r\n\r\nBerat Terdaftar: 409
      g\r\n\r\nProfil Kecocokan: F-09\r\n\r\nLokasi Normal: Rak Arsip A-17\r\n\r\nTujuan:
      Latihan penanganan oleh staf\r\n\r\n\r\nCW-412 \u2014 BEBAN KALIBRASI\r\n\r\nBerat
      Terdaftar: 412 g\r\n\r\nProfil Kecocokan: TIDAK TERDAFTAR \u2014 hanya alat
      kalibrasi\r\n\r\nLokasi Normal: Rak Kalibrasi Pemeliharaan\r\n\r\nTujuan: Kalibrasi
      sensor\r\n\r\n\r\nPERINGATAN REGISTRI:\r\n\r\nBerat saja tidak boleh digunakan
      untuk memastikan identitas objek.\r\n\r\nProfil Kecocokan harus dicocokkan
      dengan aktivitas pajangan sebelum objek yang ditukar dapat diidentifikasi."
  document2:
    evidenceID: E12_A17_C02_AUDIT
    tabName: SHELF & CABINET AUDIT
    evidenceTitle: A-17 SHELF & C-02 CABINET AUDIT
    evidenceType: PHYSICAL INVENTORY AUDIT
    evidenceBody: "ARCHIVE SHELF A-17 \u2014 WEIGHT SNAPSHOTS\r\n\r\n19:00 409 g\r\n20:00
      409 g\r\n20:25 412 g\r\n08:06 412 g / shelf locked during museum lockdown\r\n\r\nSHELF
      NOTE:\r\nA-17 records periodic weight only. It does not identify objects.\r\n\r\n\r\nREPLICA
      CABINET C-02 \u2014 PHYSICAL AUDIT\r\n\r\n19:36:04 ER-12 CHECKED OUT \u2014
      CUR-02\n\r\n19:36:06 SLOT C-02-ER12 LATCH OPENED\n\r\n19:36:21 SLOT LATCH CLOSED
      \u2014 SLOT EMPTY\r\n\r\n19:52:18 DIGITAL RETURN ENTRY CREATED \u2014 CUR-02\n\r\n19:52:18
      PHYSICAL LATCH EVENT: NONE\r\n\r\n08:07:30 SLOT INSPECTION \u2014 EMPTY\r\n\r\nAUDIT
      RESULT:\r\nER-12 was checked out physically. The later return exists only as
      a database entry."
    tabNameIndonesian: AUDIT RAK & LEMARI
    evidenceTitleIndonesian: AUDIT RAK A-17 & LEMARI C-02
    evidenceTypeIndonesian: CATATAN AUDIT
    evidenceBodyIndonesian: "RAK ARSIP A-17 \u2014 REKAMAN BERAT\r\n\r\n19:00 409
      g\r\n\r\n20:00 409 g\r\n\r\n20:25 412 g\r\n\r\n08:06 412 g / rak dikunci selama
      lockdown museum\r\n\r\n\r\nCATATAN RAK:\r\n\r\nA-17 hanya mencatat berat secara
      berkala.\r\n\r\nSistem ini tidak mengidentifikasi objek.\r\n\r\n\r\nLEMARI
      REPLIKA C-02 \u2014 AUDIT FISIK\r\n\r\n19:36:04 ER-12 DIAMBIL \u2014 CUR-02\r\n\r\n19:36:06
      PENGUNCI SLOT C-02-ER12 DIBUKA\r\n\r\n19:36:21 PENGUNCI SLOT DITUTUP \u2014
      SLOT KOSONG\r\n\r\n19:52:18 ENTRI PENGEMBALIAN DIGITAL DIBUAT \u2014 CUR-02\r\n\r\n19:52:18
      AKTIVITAS PENGUNCI FISIK: TIDAK ADA\r\n\r\n08:07:30 PEMERIKSAAN SLOT \u2014
      KOSONG\r\n\r\n\r\nHASIL AUDIT:\r\n\r\nER-12 diambil secara fisik.\r\n\r\nCatatan
      pengembalian setelahnya hanya ada sebagai entri dalam database."
  hotspotName: COLLECTION DATABASE
  hotspotContentSummary: 2 DOCUMENTS
  hotspotNameIndonesian: DATABASE KOLEKSI
  hotspotContentSummaryIndonesian: 2 DOKUMEN
  hotspotNameText: {fileID: 1200008577}
  hotspotCountText: {fileID: 1728332753}
  presentationStyle: 3
  popupController: {fileID: 869402488}
