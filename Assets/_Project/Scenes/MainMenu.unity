  m_Script: {fileID: 11500000, guid: 3fced0ba2eb752e4a9c956988bb4e7a8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LocalizedText
  englishText: "\u2022 Click investigation objects to examine evidence.\r\n\r\n\u2022
    Use the Museum Map to move between investigation rooms.\r\n\r\n\u2022 Compare
    evidence, timelines, and suspect statements.\r\n\r\n\u2022 Open the Character
    File to review each suspect\u2019s role and access.\r\n\r\n\u2022 Use the Detective
    Board to select the culprit and hiding location.\r\n\r\n\u2022 You have 10 minutes
    and only one final submission."
  indonesianText: "\u2022 Klik objek investigasi untuk memeriksa bukti.\r\n\r\n\u2022
    Gunakan Peta Museum untuk berpindah antar-ruangan investigasi.\r\n\r\n\u2022
    Bandingkan bukti, urutan waktu, dan pernyataan para tersangka.\r\n\r\n\u2022
    Buka File Karakter untuk memeriksa peran dan akses setiap tersangka.\r\n\r\n\u2022
    Gunakan Papan Detektif untuk memilih pelaku dan lokasi persembunyian.\r\n\r\n\u2022
    Kalian memiliki waktu 10 menit dan hanya satu kesempatan untuk mengirim jawaban
    akhir."
